# ---------------------------------------------------------------------------
# SECRET (server-side) variables for the Cloudflare Pages Function.
# Copy to `.dev.vars` for local `wrangler pages dev`, and set the same keys in
# Cloudflare Pages → Settings → Environment variables for production.
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Cloudflare Turnstile SECRET key. Default below is the "always passes" TEST key.
# TODO(client): real Turnstile secret key.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend API key — https://resend.com/api-keys
# TODO(client): real Resend API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where leads are delivered.
# TODO(client): real destination inbox.
LEAD_TO_EMAIL=leads@frpsmd.com

# Verified Resend sender (must be on a domain verified in Resend).
# TODO(client): verified sender address.
LEAD_FROM_EMAIL=leads@frpsmd.com
