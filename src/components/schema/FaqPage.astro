---
/**
 * FAQPage JSON-LD. Pass the FAQ list.
 */
import type { Faq } from '../../data/faq';

interface Props {
  faqs: Faq[];
}
const { faqs } = Astro.props;

const json = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---
<script type="application/ld+json" set:html={JSON.stringify(json)} is:inline />
