---
/**
 * Sitewide LocalBusiness JSON-LD. Rendered once per page via BaseLayout.
 * areaServed = counties; open 7 days a week (exact hours TODO(client)).
 */
import { site } from '../../config/site';
import { counties } from '../../data/counties';

const json = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${site.url}/#business`,
  name: site.name,
  legalName: site.legalName,
  description: site.description,
  url: site.url,
  telephone: site.phone.e164,
  email: site.email,
  image: `${site.url}/og-default.png`,
  logo: `${site.url}/logo-mark.png`,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street || undefined,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
  areaServed: counties.map((c) => ({
    '@type': 'AdministrativeArea',
    name: `${c.name}, Maryland`,
  })),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    },
  ],
  sameAs: Object.values(site.social).filter(Boolean),
};
---
<script type="application/ld+json" set:html={JSON.stringify(json)} is:inline />
