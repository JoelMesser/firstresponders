---
/**
 * BreadcrumbList JSON-LD + optional visible breadcrumb trail.
 * Pass an ordered list of { name, href } (href relative or absolute).
 */
import { site } from '../../config/site';

interface Crumb {
  name: string;
  href: string;
}
interface Props {
  items: Crumb[];
  visible?: boolean;
}
const { items, visible = true } = Astro.props;

const json = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: new URL(item.href, site.url).href,
  })),
};
---
<script type="application/ld+json" set:html={JSON.stringify(json)} is:inline />
{
  visible && (
    <nav aria-label="Breadcrumb" class="container-px py-4 text-caption text-mute">
      <ol class="flex flex-wrap items-center gap-1.5">
        {items.map((item, i) => (
          <li class="flex items-center gap-1.5">
            {i > 0 && <span aria-hidden="true" class="text-line">/</span>}
            {i < items.length - 1 ? (
              <a href={item.href} class="hover:text-green hover:underline">
                {item.name}
              </a>
            ) : (
              <span class="font-semibold text-ink" aria-current="page">
                {item.name}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}
