---
/**
 * Button / link button.
 *  - variant="primary"   -> RED. Reserved exclusively for calls-to-action.
 *  - variant="secondary" -> green outline.
 *  - variant="ghost"     -> subtle, for less prominent actions.
 * Renders an <a> when `href` is provided, otherwise a <button>.
 */
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  type?: 'button' | 'submit';
  size?: 'md' | 'lg';
  class?: string;
  icon?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  size = 'md',
  class: className = '',
  icon,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-display font-bold uppercase tracking-wide rounded-md transition-colors duration-150 focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-2';

const sizes = {
  md: 'px-5 py-2.5 text-[0.95rem]',
  lg: 'px-7 py-3.5 text-base sm:text-lg',
};

const variants = {
  // RED — CTA only.
  primary:
    'bg-red text-white shadow-sm hover:bg-red-dark active:bg-red-dark focus-visible:outline-red',
  secondary:
    'border-2 border-green text-green bg-white hover:bg-green hover:text-white focus-visible:outline-green',
  ghost: 'text-green hover:text-green-deep underline-offset-4 hover:underline',
};

const cls = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
---
{
  href ? (
    <a href={href} class={cls} {...rest}>
      {icon && <Icon name={icon} size={20} />}
      <slot />
    </a>
  ) : (
    <button type={type} class={cls} {...rest}>
      {icon && <Icon name={icon} size={20} />}
      <slot />
    </button>
  )
}
