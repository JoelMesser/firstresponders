---
/**
 * Lead form. Progressive enhancement:
 *  - Works with NO JS: native POST to /api/lead, server redirects to /contact?sent=1.
 *  - With JS: intercepts submit, POSTs JSON, shows an inline thank-you state.
 * Spam protection via Cloudflare Turnstile.
 *
 * TODO(client): set PUBLIC_TURNSTILE_SITE_KEY (and TURNSTILE_SECRET_KEY on the
 * Function) to your real keys. The default below is Cloudflare's "always passes"
 * TEST key — replace before launch.
 */
import { site } from '../config/site';
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const TURNSTILE_SITE_KEY =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA'; // TODO(client): real key

const damageTypes = ['Water', 'Fire & Smoke', 'Mold', 'Storm', 'Sewage / Biohazard', 'Other'];

const inputCls =
  'w-full rounded-md border border-line bg-white px-3.5 py-2.5 text-ink placeholder:text-mute/70 focus:border-green focus:outline-none focus:ring-2 focus:ring-green/30';
const labelCls = 'block font-display text-sm font-semibold text-ink';
---
<form
  class="lead-form"
  method="POST"
  action="/api/lead"
  novalidate
  data-turnstile-key={TURNSTILE_SITE_KEY}
>
  <!-- Honeypot (hidden from humans; bots fill it). -->
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label>Do not fill this in: <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="grid gap-4" class:list={[{ 'sm:grid-cols-2': !compact }]}>
    <div>
      <label class={labelCls} for="lf-name">Name <span class="text-red">*</span></label>
      <input class={`mt-1 ${inputCls}`} id="lf-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div>
      <label class={labelCls} for="lf-phone">Phone <span class="text-red">*</span></label>
      <input class={`mt-1 ${inputCls}`} id="lf-phone" name="phone" type="tel" autocomplete="tel" required />
    </div>
  </div>

  <div class="mt-4">
    <label class={labelCls} for="lf-address">Property Address</label>
    <input class={`mt-1 ${inputCls}`} id="lf-address" name="address" type="text" autocomplete="street-address" placeholder="Street, City, MD" />
  </div>

  <div class="mt-4">
    <label class={labelCls} for="lf-damage">Type of Damage <span class="text-red">*</span></label>
    <select class={`mt-1 ${inputCls}`} id="lf-damage" name="damageType" required>
      <option value="" disabled selected>Select…</option>
      {damageTypes.map((t) => <option value={t}>{t}</option>)}
    </select>
  </div>

  <div class="mt-4">
    <label class={labelCls} for="lf-message">What happened?</label>
    <textarea class={`mt-1 ${inputCls}`} id="lf-message" name="message" rows={compact ? 2 : 3} placeholder="Briefly describe the damage…"></textarea>
  </div>

  <label class="mt-4 flex items-start gap-2.5 rounded-md bg-red/5 p-3 text-sm">
    <input type="checkbox" name="emergency" value="yes" class="mt-0.5 h-5 w-5 accent-red" />
    <span class="text-ink">
      <strong>This is an active emergency.</strong>
      <span class="block text-mute">
        For active emergencies, please <a href={site.phone.href} class="font-bold text-red underline">call {site.phone.display}</a> now — don't wait on a form.
      </span>
    </span>
  </label>

  <!-- Turnstile widget renders here (explicit render via the script below). -->
  <div class="cf-turnstile mt-4" data-sitekey={TURNSTILE_SITE_KEY}></div>

  <div class="lead-form__error mt-3 hidden rounded-md bg-red/10 px-3 py-2 text-sm text-red-dark" role="alert"></div>

  <Button type="submit" size="lg" class="mt-4 w-full">
    <Icon name="phone" size={20} /> Send My Request
  </Button>

  <p class="mt-3 text-center text-caption text-mute">
    We respond fast. Your information is only used to contact you about your request.
  </p>
</form>

<!-- Success state (revealed by JS on successful submit). -->
<div class="lead-form__success hidden rounded-xl border border-green/30 bg-green/5 p-6 text-center">
  <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-green text-white">
    <Icon name="check" size={26} />
  </span>
  <h3 class="mt-4 font-display text-h3 font-bold text-green-deep">Request received</h3>
  <p class="mt-2 text-mute">
    Thanks — we'll be in touch shortly. If this is an active emergency, please
    <a href={site.phone.href} class="font-bold text-red underline">call {site.phone.display}</a> now.
  </p>
</div>

<!-- Cloudflare Turnstile -->
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  // Progressive enhancement: intercept submit and POST JSON; fall back to native
  // form POST if anything goes wrong.
  document.querySelectorAll<HTMLFormElement>('form.lead-form').forEach((form) => {
    const errorBox = form.querySelector<HTMLElement>('.lead-form__error');
    const successBox = form.parentElement?.querySelector<HTMLElement>('.lead-form__success');

    form.addEventListener('submit', async (e) => {
      // Let the browser do a native POST if fetch isn't available.
      if (typeof fetch !== 'function') return;
      e.preventDefault();

      if (errorBox) errorBox.classList.add('hidden');
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.dataset.label = submitBtn.innerHTML;
        submitBtn.textContent = 'Sending…';
      }

      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });

        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          throw new Error(body.error || 'Something went wrong. Please call us.');
        }

        form.classList.add('hidden');
        successBox?.classList.remove('hidden');
        successBox?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (err) {
        if (errorBox) {
          errorBox.textContent =
            (err as Error).message || 'Could not send. Please call us directly.';
          errorBox.classList.remove('hidden');
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          if (submitBtn.dataset.label) submitBtn.innerHTML = submitBtn.dataset.label;
        }
        // Reset Turnstile so the user can retry.
        (window as any).turnstile?.reset();
      }
    });
  });
</script>
