---
import Icon from './Icon.astro';

/** 4-step service process. TODO(client): confirm wording matches your workflow. */
const steps = [
  {
    icon: 'phone',
    title: 'Call or Request Online',
    body: 'Reach a real person. Tell us what the property needs — photos help, but a call is enough.',
  },
  {
    icon: 'doc',
    title: 'Walkthrough & Free Estimate',
    body: 'We scope the work on site (or from photos) and give you a clear, itemized estimate.',
  },
  {
    icon: 'check',
    title: 'We Do the Work',
    body: 'Scheduled, on time, and done right — one crew for repairs, maintenance, cleaning, and hauling.',
  },
  {
    icon: 'shield',
    title: 'Walkthrough & Easy Invoice',
    body: 'You review the finished work, with before/after photos and one clean invoice.',
  },
];

interface Props {
  tone?: 'mist' | 'white';
}
const { tone = 'mist' } = Astro.props;
const onDark = false;
---
<ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
  {
    steps.map((step, i) => (
      <li class="relative rounded-xl border border-line bg-white p-6">
        <span class="absolute right-4 top-4 font-display text-4xl font-extrabold text-line">
          {String(i + 1).padStart(2, '0')}
        </span>
        <span class="flex h-12 w-12 items-center justify-center rounded-lg bg-green text-white">
          <Icon name={step.icon} size={24} />
        </span>
        <h3 class="mt-4 font-display text-h3 font-bold text-ink">{step.title}</h3>
        <p class="mt-2 text-sm text-mute">{step.body}</p>
      </li>
    ))
  }
</ol>
