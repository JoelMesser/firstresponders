---
import Icon from './Icon.astro';
import type { Review } from '../data/reviews';

interface Props {
  review: Review;
}
const { review } = Astro.props;
const stars = Array.from({ length: 5 }, (_, i) => i < review.rating);
---
<figure class="flex h-full flex-col rounded-xl border border-line bg-white p-6 shadow-sm">
  <div class="flex gap-0.5 text-gold" aria-label={`${review.rating} out of 5 stars`}>
    {stars.map((on) => <Icon name="star" size={18} class={on ? 'fill-gold' : 'opacity-25'} />)}
  </div>
  <blockquote class="mt-4 flex-1 text-ink">
    <p>“{review.quote}”</p>
  </blockquote>
  <figcaption class="mt-5 border-t border-line pt-4">
    <p class="font-display font-bold text-ink">{review.name}</p>
    <p class="text-caption text-mute">{review.location} · {review.service}</p>
  </figcaption>
</figure>
