---
import { site } from '../config/site';
import Button from './Button.astro';
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
import TrustBadges from './TrustBadges.astro';

interface Props {
  title?: string;
  subtitle?: string;
  /** Show the inline lead-form card (home page). */
  showForm?: boolean;
}
const {
  title = 'When Disaster Strikes, We Respond First',
  subtitle = '24/7 emergency water, fire, mold, and storm restoration across Central Maryland. Veteran & first-responder owned. We secure your property, stop the damage, and work directly with your insurance.',
  showForm = false,
} = Astro.props;
---
<section class="relative overflow-hidden bg-green-deep text-white">
  <!--
    TODO(client): drop a hero photo here once supplied. Suggested:
    <img src="/hero.jpg" alt="..." class="absolute inset-0 h-full w-full object-cover opacity-25" />
    Keep an overlay for text contrast (WCAG AA) and set width/height to avoid CLS.
  -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.07]"
    style="background-image: radial-gradient(circle at 20% 20%, #C0901F 0, transparent 40%), radial-gradient(circle at 80% 0%, #006428 0, transparent 50%);"
    aria-hidden="true"
  >
  </div>

  <div class="container-px relative grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-2 lg:gap-12">
    <div class={showForm ? '' : 'mx-auto max-w-3xl text-center'}>
      <p class="inline-flex items-center gap-2 rounded-full border border-gold/40 bg-green-darker/40 px-3 py-1 font-display text-caption font-semibold uppercase tracking-[0.14em] text-gold-light">
        <Icon name="star" size={14} /> Veteran &amp; First Responder Owned
      </p>
      <h1 class="mt-5 text-hero font-extrabold">{title}</h1>
      <p class="mt-5 max-w-xl text-lg text-white/85">{subtitle}</p>

      <div class={`mt-8 flex flex-col gap-3 sm:flex-row ${showForm ? '' : 'sm:justify-center'}`}>
        <Button href={site.phone.href} size="lg" icon="phone">
          Call {site.phone.display}
        </Button>
        <Button href="/contact/" variant="secondary" size="lg" class="!border-white !text-white hover:!bg-white hover:!text-green-deep">
          Request Help Online
        </Button>
      </div>
      <p class="mt-4 text-caption text-white/70">
        Answered 24/7 · Fast dispatch · Direct insurance billing
      </p>

      <div class="mt-8">
        <TrustBadges variant="hero" />
      </div>
    </div>

    {
      showForm && (
        <div class="rounded-xl border border-white/10 bg-white p-5 text-ink shadow-2xl sm:p-6">
          <div class="mb-4">
            <h2 class="font-display text-xl font-extrabold text-green-deep">Get Emergency Help Now</h2>
            <p class="mt-1 text-sm text-mute">
              Active emergency? <a href={site.phone.href} class="font-bold text-red underline">Call {site.phone.display}</a> — don't wait on a form.
            </p>
          </div>
          <LeadForm compact />
        </div>
      )
    }
  </div>

  <!-- Gold hairline at the base of the hero. -->
  <div class="h-1 w-full bg-gradient-to-r from-gold/30 via-gold to-gold/30" aria-hidden="true"></div>
</section>
