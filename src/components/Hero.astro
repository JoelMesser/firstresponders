---
import { site } from '../config/site';
import Button from './Button.astro';
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
import TrustBadges from './TrustBadges.astro';

interface Props {
  title?: string;
  subtitle?: string;
  /** Show the lead-form band below the hero (home page). */
  showForm?: boolean;
  /** Hero panel image path. */
  image?: string;
  imageAlt?: string;
}
const {
  title = 'Your First Call Can Solve It All',
  subtitle = 'Property management support, inspections, handyman repairs, and maintenance — inside and out — across Central Maryland. Veteran & first-responder owned: one trusted crew for every job on your list.',
  showForm = false,
  image = '/images/hero.webp',
  imageAlt = 'A well-kept American home — the kind of property we maintain and care for',
} = Astro.props;
---
<section class="hero-surface relative overflow-hidden text-ink">
  <div class="container-px relative grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-2 lg:gap-12">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-green/25 bg-green/5 px-3 py-1 font-display text-caption font-semibold uppercase tracking-[0.14em] text-green">
        <Icon name="star" size={14} /> Veteran &amp; First Responder Owned
      </p>
      <h1 class="mt-5 text-hero font-extrabold text-ink">{title}</h1>
      <p class="mt-5 max-w-xl text-lg text-mute">{subtitle}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={site.phone.href} size="lg" icon="phone">
          Call {site.phone.display}
        </Button>
        <Button href={showForm ? '#help' : '/contact/'} variant="secondary" size="lg">
          Request a Free Estimate
        </Button>
      </div>
      <p class="mt-4 text-caption text-mute">
        Fast scheduling · Free estimates · Licensed & insured
      </p>

      <div class="mt-8">
        <TrustBadges />
      </div>
    </div>

    <!-- Crisp photo panel. TODO(client): swap in your own on-site job photos. -->
    <div class="relative">
      <div
        class="absolute -bottom-4 -right-4 -z-10 hidden h-full w-full rounded-2xl bg-green/10 lg:block"
        aria-hidden="true"
      >
      </div>
      <img
        src={image}
        alt={imageAlt}
        width="1200"
        height="1000"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-[5/4] w-full rounded-2xl border border-line object-cover shadow-xl"
      />
      <div class="absolute bottom-3 left-3 flex items-center gap-2 rounded-lg bg-white/95 px-3 py-2 shadow-md backdrop-blur">
        <Icon name="shield" size={18} class="text-green" />
        <span class="font-display text-sm font-bold text-ink">Licensed &amp; Insured · Veteran Owned</span>
      </div>
    </div>
  </div>
  <div class="h-px w-full rule-accent" aria-hidden="true"></div>
</section>

{
  showForm && (
    <section id="help" class="scroll-mt-24 bg-haze">
      <div class="container-px grid items-center gap-8 py-12 sm:py-16 lg:grid-cols-2">
        <div>
          <p class="accent-left font-display text-caption font-bold uppercase tracking-[0.14em] text-gold-deep">
            Get Help Now
          </p>
          <h2 class="mt-3 text-3xl font-extrabold text-ink sm:text-h2">
            Tell Us What You Need — We'll Respond Fast
          </h2>
          <p class="mt-4 max-w-xl text-lg text-mute">
            Send a few details about the job and we'll reach out right away with an honest
            estimate and a real timeline. Urgent property issue? Calling is fastest.
          </p>
          <a
            href={site.phone.href}
            class="mt-6 inline-flex items-center gap-3 rounded-xl bg-red px-5 py-3 text-white shadow-sm transition-colors hover:bg-red-dark"
          >
            <Icon name="phone" size={24} />
            <span>
              <span class="block font-display text-caption font-semibold uppercase tracking-wide text-white/80">
                Call Us
              </span>
              <span class="block font-display text-xl font-extrabold">{site.phone.display}</span>
            </span>
          </a>
        </div>

        <div class="overflow-hidden rounded-xl border border-line bg-white text-ink shadow-xl">
          <div class="h-1 w-full rule-accent" aria-hidden="true" />
          <div class="p-5 sm:p-6">
            <div class="mb-4">
              <h3 class="font-display text-xl font-extrabold text-green-deep">Get a Free Estimate</h3>
              <p class="mt-1 text-sm text-mute">
                Urgent issue?{' '}
                <a href={site.phone.href} class="font-bold text-red underline">
                  Call {site.phone.display}
                </a>{' '}
                — it's faster than a form.
              </p>
            </div>
            <LeadForm compact />
          </div>
        </div>
      </div>
    </section>
  )
}
