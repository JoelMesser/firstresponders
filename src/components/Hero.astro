---
import { site } from '../config/site';
import Button from './Button.astro';
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
import TrustBadges from './TrustBadges.astro';

interface Props {
  title?: string;
  subtitle?: string;
  /** Show the inline lead-form card (home page). */
  showForm?: boolean;
}
const {
  title = 'When Disaster Strikes, We Respond First',
  subtitle = '24/7 emergency water, fire, mold, and storm restoration across Central Maryland. Veteran & first-responder owned. We secure your property, stop the damage, and work directly with your insurance.',
  showForm = false,
} = Astro.props;
---
<section class="hero-surface relative overflow-hidden text-ink">
  <!--
    TODO(client): drop a hero photo here once supplied. On this LIGHT hero, place it
    as a bordered image inside the right column (or behind, with a paper scrim for
    contrast). Set width/height to avoid CLS.
  -->
  <!-- Faint green dot grid for subtle texture (a green highlight, not a fill). -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.5]"
    style="background-image: radial-gradient(rgba(7,105,44,0.10) 1px, transparent 1.4px); background-size: 24px 24px; mask-image: linear-gradient(to bottom, black, transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="container-px relative grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-2 lg:gap-12">
    <div class={showForm ? '' : 'mx-auto max-w-3xl text-center'}>
      <p class={`inline-flex items-center gap-2 rounded-full border border-green/25 bg-green/5 px-3 py-1 font-display text-caption font-semibold uppercase tracking-[0.14em] text-green ${showForm ? '' : 'mx-auto'}`}>
        <Icon name="star" size={14} /> Veteran &amp; First Responder Owned
      </p>
      <h1 class="mt-5 text-hero font-extrabold text-ink">{title}</h1>
      <p class="mt-5 max-w-xl text-lg text-mute">{subtitle}</p>

      <div class={`mt-8 flex flex-col gap-3 sm:flex-row ${showForm ? '' : 'sm:justify-center'}`}>
        <Button href={site.phone.href} size="lg" icon="phone">
          Call {site.phone.display}
        </Button>
        <Button href="/contact/" variant="secondary" size="lg">
          Request Help Online
        </Button>
      </div>
      <p class="mt-4 text-caption text-mute">
        Answered 24/7 · Fast dispatch · Direct insurance billing
      </p>

      <div class="mt-8">
        <TrustBadges />
      </div>
    </div>

    {
      showForm && (
        <div class="overflow-hidden rounded-xl border border-line bg-white text-ink shadow-xl">
          <div class="h-1 w-full rule-accent" aria-hidden="true" />
          <div class="p-5 sm:p-6">
            <div class="mb-4">
              <h2 class="font-display text-xl font-extrabold text-green-deep">Get Emergency Help Now</h2>
              <p class="mt-1 text-sm text-mute">
                Active emergency? <a href={site.phone.href} class="font-bold text-red underline">Call {site.phone.display}</a> — don't wait on a form.
              </p>
            </div>
            <LeadForm compact />
          </div>
        </div>
      )
    }
  </div>

  <!-- Accent hairline at the base of the hero. -->
  <div class="h-px w-full rule-accent" aria-hidden="true"></div>
</section>
