  fire: '<path d="M12 2c1 4-2 5-2 8a2 2 0 1 0 4 0c0-1 0-1.5.5-2 1 2 3.5 3 3.5 6a6 6 0 1 1-12 0c0-4 4-6 6-12Z"/>',
  mold: '<circle cx="7" cy="9" r="3"/><circle cx="15" cy="7" r="2.5"/><circle cx="13" cy="15" r="3.5"/><circle cx="6" cy="16" r="2"/>',
  storm: '<path d="M7 14a5 5 0 1 1 1.5-9.8A6 6 0 0 1 19 8a4 4 0 0 1-1 7.9"/><path d="m12 13-2 4h3l-2 4"/>',
  biohazard: '<circle cx="12" cy="12" r="2.2"/><path d="M12 9.8c-1.6-2.8-1-5.6.8-7m-.8 7c-2.9-1.6-5.6-1-7 .8m9.4 2.4c3.2 0 5.4 1.7 6 4m-12 0c.6-2.3 2.8-4 6-4M5 13.6c1.4 1.8 4.1 2.4 7 .8"/>',
  demolition: '<path d="M14 3l7 7-3 3-7-7zM11 6 3 14v7h7l8-8"/>',
  reconstruction: '<path d="M3 21h18M5 21V11l7-5 7 5v10M9 21v-6h6v6"/>',
  boardup: '<rect x="4" y="4" width="16" height="16" rx="1"/><path d="M4 9h16M4 14h16M9 4v16M15 4v16"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-1Z"/>',
  shield: '<path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3Z"/>',
  star: '<path d="M12 3l2.6 5.5 6 .8-4.4 4.2 1.1 6L12 16.8 6.7 19.5l1.1-6L3.4 9.3l6-.8L12 3Z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  badge: '<path d="M12 2l2.5 2 3.5-.3 1 3.3 2.5 2.4-1.6 3.1.5 3.5-3.4.9-2 2.9L12 21l-3-1.5-2-2.9-3.4-.9.5-3.5L2.5 9l2.5-2.4 1-3.3L9.5 4 12 2Z"/><path d="m9 12 2 2 4-4"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  map: '<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Zm0 0v14m6-12v14"/>',
  drop: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/>',
