---
/**
 * Inline SVG icons (no icon library — keeps the bundle tiny and LCP fast).
 * All icons use `currentColor` and inherit size from the parent font-size
 * unless width/height props are passed.
 */
interface Props {
  name: string;
  class?: string;
  size?: number;
}
const { name, class: className = '', size = 24 } = Astro.props;

const paths: Record<string, string> = {
