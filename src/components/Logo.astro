---
/**
 * Wordmark logo (typographic placeholder).
 * TODO(client): replace with the real logo SVG in /public/logo.svg and swap
 * this for an <img>. Keep dimensions stable to avoid layout shift.
 */
import { site } from '../config/site';

interface Props {
  variant?: 'dark' | 'light'; // text color context
  class?: string;
}
const { variant = 'dark', class: className = '' } = Astro.props;
const main = variant === 'light' ? 'text-white' : 'text-green';
const sub = variant === 'light' ? 'text-gold-light' : 'text-gold';
---
<span class={`flex flex-col leading-none ${className}`} aria-label={site.name}>
  <span class={`font-display font-extrabold uppercase tracking-tight text-lg sm:text-xl ${main}`}>
    First Response
  </span>
  <span class={`font-display font-semibold uppercase tracking-[0.18em] text-[0.62rem] sm:text-[0.7rem] ${sub}`}>
    Property Solutions
  </span>
</span>
