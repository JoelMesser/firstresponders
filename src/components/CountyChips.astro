---
import { counties } from '../data/counties';
import Icon from './Icon.astro';

interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'light' } = Astro.props;
const dark = variant === 'dark';
---
<ul class="flex flex-wrap gap-2.5">
  {
    counties.map((c) => (
      <li>
        <a
          href={`/service-areas/${c.slug}`}
          class={`inline-flex items-center gap-1.5 rounded-full border px-4 py-2 font-display text-sm font-semibold transition-colors ${
            dark
              ? 'border-white/20 text-white hover:border-gold hover:bg-white/10'
              : 'border-line bg-white text-ink hover:border-gold hover:text-green'
          }`}
        >
          <Icon name="map" size={15} class={dark ? 'text-gold-light' : 'text-gold'} />
          {c.short}
        </a>
      </li>
    ))
  }
</ul>
