---
/**
 * Sticky bottom click-to-call bar — mobile only. Always one tap from a call.
 */
import { site } from '../config/site';
import Icon from './Icon.astro';
---
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-red-dark/40 bg-red text-white shadow-[0_-4px_12px_rgba(0,0,0,0.15)] lg:hidden">
  <a
    href={site.phone.href}
    class="flex items-center justify-center gap-2 py-3 font-display text-lg font-extrabold uppercase tracking-wide"
  >
    <Icon name="phone" size={22} />
    Call Now · 24/7
  </a>
</div>
<!-- Spacer so the fixed bar never covers page content on mobile. -->
<div class="h-14 lg:hidden" aria-hidden="true"></div>
