---
import Icon from './Icon.astro';

interface Props {
  /** `light` = green icons for light backgrounds; `dark` = gold icons for dark backgrounds. */
  variant?: 'light' | 'dark';
  align?: 'left' | 'center';
}
const { variant = 'light', align = 'left' } = Astro.props;

const items = [
  { icon: 'clock', label: 'Fast Scheduling' },
  { icon: 'shield', label: 'Licensed & Insured' },
  { icon: 'badge', label: 'Veteran Owned' },
  { icon: 'doc', label: 'Free Estimates' },
];
const onDark = variant === 'dark';
---
<ul class={`flex flex-wrap gap-x-5 gap-y-3 ${align === 'center' ? 'justify-center' : ''}`}>
  {
    items.map((item) => (
      <li class={`flex items-center gap-2 font-display text-sm font-semibold ${onDark ? 'text-white/90' : 'text-ink'}`}>
        <span class={`flex h-8 w-8 items-center justify-center rounded-full ${onDark ? 'bg-gold/20 text-gold-light' : 'bg-green/10 text-green'}`}>
          <Icon name={item.icon} size={18} />
        </span>
        {item.label}
      </li>
    ))
  }
</ul>
