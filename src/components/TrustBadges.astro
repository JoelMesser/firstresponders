---
import { site } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  variant?: 'hero' | 'row';
}
const { variant = 'row' } = Astro.props;

const items = [
  { icon: 'clock', label: '24/7 Response' },
  { icon: 'shield', label: 'Licensed & Insured' },
  { icon: 'badge', label: 'Veteran Owned' },
  { icon: 'doc', label: 'We Bill Insurance' },
];
const onHero = variant === 'hero';
---
<ul class={`flex flex-wrap gap-x-5 gap-y-3 ${onHero ? '' : 'justify-center'}`}>
  {
    items.map((item) => (
      <li class={`flex items-center gap-2 font-display text-sm font-semibold ${onHero ? 'text-white/90' : 'text-ink'}`}>
        <span class={`flex h-8 w-8 items-center justify-center rounded-full ${onHero ? 'bg-gold/20 text-gold-light' : 'bg-green/10 text-green'}`}>
          <Icon name={item.icon} size={18} />
        </span>
        {item.label}
      </li>
    ))
  }
</ul>
