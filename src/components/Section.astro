---
/**
 * Standard content section: optional eyebrow + h2 (with gold left accent) + slot.
 * `tone` controls background. Use `as` to change the heading level if needed.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
  tone?: 'white' | 'mist' | 'tint' | 'green' | 'green-deep';
  align?: 'left' | 'center';
  id?: string;
  class?: string;
  headingId?: string;
}

const {
  eyebrow,
  title,
  lede,
  tone = 'white',
  align = 'left',
  id,
  class: className = '',
  headingId,
} = Astro.props;

const tones = {
  white: 'bg-white text-ink',
  mist: 'bg-mist text-ink',
  tint: 'bg-haze text-ink', // faint green-tinted "highlight" zone (light)
  green: 'bg-green text-white',
  'green-deep': 'bg-green-deep text-white',
};
const onDark = tone === 'green' || tone === 'green-deep';
const ledeColor = onDark ? 'text-white/85' : 'text-mute';
const alignCls = align === 'center' ? 'text-center mx-auto' : '';
---
<section id={id} class={`py-14 sm:py-20 ${tones[tone]} ${className}`}>
  <div class="container-px">
    {
      (eyebrow || title) && (
        <div class={`max-w-3xl ${alignCls} mb-8 sm:mb-12`}>
          {eyebrow && (
            <p class={`${align === 'center' ? '' : 'accent-left'} font-display font-bold uppercase tracking-[0.14em] text-caption ${onDark ? 'text-gold-light' : 'text-gold-deep'}`}>
              {eyebrow}
            </p>
          )}
          {title && (
            <h2 id={headingId} class="mt-3 text-3xl sm:text-h2 font-extrabold">
              {title}
            </h2>
          )}
          {lede && <p class={`mt-4 text-lg ${ledeColor}`}>{lede}</p>}
        </div>
      )
    }
    <slot />
  </div>
</section>
