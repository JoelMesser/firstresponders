---
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import InsuranceSteps from '../components/InsuranceSteps.astro';
import Section from '../components/Section.astro';
import Breadcrumbs from '../components/schema/Breadcrumbs.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const points = [
  'We document the damage with photos, moisture readings, and a detailed scope.',
  'We communicate directly with your adjuster on your behalf.',
  'We bill your insurance company directly where your policy allows.',
  'You typically pay only your deductible. TODO(client): confirm.',
];
---
<BaseLayout
  title="Insurance Claims — We Work Directly With Your Insurer"
  description="We make property damage insurance claims simple: documentation, direct adjuster coordination, and direct billing. Serving Central Maryland 24/7."
>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Insurance', href: '/insurance/' }]} />

  <Section
    eyebrow="Insurance"
    title="We Work Directly With Your Insurance"
    lede="A property loss is stressful enough. We handle the documentation and the adjuster so you can focus on getting back to normal."
  >
    <div class="grid gap-8 lg:grid-cols-3">
      <ul class="space-y-3 lg:col-span-2">
        {
          points.map((p) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green text-white">
                <Icon name="check" size={15} />
              </span>
              <span class="text-lg text-ink">{p}</span>
            </li>
          ))
        }
      </ul>
      <aside class="rounded-xl border border-line border-l-4 border-l-gold bg-mist p-6">
        <h2 class="font-display text-h3 font-bold text-green-deep">Filed a claim yet?</h2>
        <p class="mt-2 text-mute">
          You don't have to file before calling us. We can start emergency mitigation right away
          and help you document the loss for your claim.
        </p>
        <a href={site.phone.href} class="mt-4 inline-flex items-center gap-2 font-display text-xl font-extrabold text-red">
          <Icon name="phone" size={22} /> {site.phone.display}
        </a>
      </aside>
    </div>
  </Section>

  <Section tone="mist" eyebrow="The Process" title="How a Claim Works With Us">
    <InsuranceSteps />
    <p class="mt-6 max-w-3xl text-sm text-mute">
      Disclaimer: Coverage depends on your specific policy and the cause of loss. We are not your
      insurer and this is not insurance advice. TODO(client): review disclaimer language.
    </p>
  </Section>

  <CtaBand title="Have Damage and a Policy? Let's Get Started." />
</BaseLayout>
