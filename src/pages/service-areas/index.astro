---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/schema/Breadcrumbs.astro';
import { site } from '../../config/site';
import { counties } from '../../data/counties';
---
<BaseLayout
  title="Service Areas in Central Maryland"
  description="First Response Property Solutions serves Anne Arundel, Howard, Baltimore, Prince George's, Montgomery, Carroll, Frederick, and Harford counties — 24/7 emergency restoration."
>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Service Areas', href: '/service-areas' }]} />
  <Section
    eyebrow="Service Areas"
    title="Serving Central Maryland, 24/7"
    lede={`We respond fast across the counties below. Don't see yours? Call ${site.phone.display} — we may still be able to help.`}
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        counties.map((c) => (
          <a
            href={`/service-areas/${c.slug}`}
            class="group flex flex-col rounded-xl border border-line border-b-4 border-b-line bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-b-gold hover:shadow-lg"
          >
            <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-green/10 text-green group-hover:bg-green group-hover:text-white">
              <Icon name="map" size={22} />
            </span>
            <h2 class="mt-4 font-display text-h3 font-bold text-ink">{c.name}</h2>
            <p class="mt-2 flex-1 text-sm text-mute">{c.blurb}</p>
            <span class="mt-4 inline-flex items-center gap-1 font-display text-sm font-bold uppercase tracking-wide text-green">
              View area <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-1" />
            </span>
          </a>
        ))
      }
    </div>
  </Section>
  <CtaBand />
</BaseLayout>
