---
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import Section from '../components/Section.astro';
import Breadcrumbs from '../components/schema/Breadcrumbs.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

// Show a success banner after a no-JS form submission (Function redirects here).
const sent = Astro.url.searchParams.get('sent') === '1';
const mapsQuery = encodeURIComponent(`${site.address.city}, ${site.address.region}`);
---
<BaseLayout
  title="Contact Us — 24/7 Emergency Restoration"
  description={`Call ${site.phone.display} for 24/7 emergency property restoration in Central Maryland, or request help online. Veteran & first-responder owned.`}
>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact/' }]} />

  <Section
    eyebrow="Contact"
    title="Get Emergency Help Now"
    lede="For an active emergency, calling is fastest. Otherwise, send us a request and we'll reach out quickly."
  >
    {
      sent && (
        <div class="mb-8 flex items-start gap-3 rounded-xl border border-green/30 bg-green/5 p-5">
          <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-green text-white">
            <Icon name="check" size={18} />
          </span>
          <div>
            <p class="font-display font-bold text-green-deep">Request received — thank you.</p>
            <p class="text-sm text-mute">
              We'll be in touch shortly. For an active emergency, please call{' '}
              <a href={site.phone.href} class="font-bold text-red underline">{site.phone.display}</a> now.
            </p>
          </div>
        </div>
      )
    }

    <div class="grid gap-10 lg:grid-cols-5">
      <!-- Contact details -->
      <div class="lg:col-span-2">
        <a
          href={site.phone.href}
          class="flex items-center gap-3 rounded-xl bg-red p-5 text-white transition-colors hover:bg-red-dark"
        >
          <Icon name="phone" size={28} />
          <span>
            <span class="block font-display text-caption font-semibold uppercase tracking-wide text-white/80">Call 24/7</span>
            <span class="block font-display text-2xl font-extrabold">{site.phone.display}</span>
          </span>
        </a>

        <dl class="mt-6 space-y-5">
          <div class="flex items-start gap-3">
            <Icon name="clock" size={22} class="mt-1 text-gold" />
            <div>
              <dt class="font-display font-bold text-ink">Hours</dt>
              <dd class="text-mute">{site.hours}</dd>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <Icon name="map" size={22} class="mt-1 text-gold" />
            <div>
              <dt class="font-display font-bold text-ink">Service Area</dt>
              <dd class="text-mute">{site.address.areaLabel} — 8 counties</dd>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <Icon name="doc" size={22} class="mt-1 text-gold" />
            <div>
              <dt class="font-display font-bold text-ink">Email</dt>
              <dd class="text-mute"><a href={`mailto:${site.email}`} class="hover:text-green hover:underline">{site.email}</a></dd>
            </div>
          </div>
        </dl>

        <!-- Map embed. TODO(client): replace query with exact address/place. -->
        <div class="mt-6 overflow-hidden rounded-xl border border-line">
          <iframe
            title={`Map of ${site.address.areaLabel}`}
            class="h-64 w-full"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            src={`https://www.google.com/maps?q=${mapsQuery}&output=embed`}
          ></iframe>
        </div>
      </div>

      <!-- Lead form -->
      <div class="rounded-xl border border-line bg-white p-6 shadow-sm lg:col-span-3">
        <h2 class="font-display text-h3 font-bold text-green-deep">Request Help Online</h2>
        <p class="mt-1 text-sm text-mute">We respond fast. Emergencies — please call.</p>
        <div class="mt-5"><LeadForm /></div>
      </div>
    </div>
  </Section>
</BaseLayout>
