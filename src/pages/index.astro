---
import Button from '../components/Button.astro';
import CountyChips from '../components/CountyChips.astro';
import CtaBand from '../components/CtaBand.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Icon from '../components/Icon.astro';
import ReviewCard from '../components/ReviewCard.astro';
import Section from '../components/Section.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import TrustBadges from '../components/TrustBadges.astro';
import { site } from '../config/site';
import { reviews } from '../data/reviews';
import BaseLayout from '../layouts/BaseLayout.astro';

const whyUs = [
  {
    icon: 'clock',
    title: 'We Actually Show Up',
    body: 'Scheduled means scheduled. We confirm, we arrive, and we finish when we said we would.',
  },
  {
    icon: 'badge',
    title: 'Veteran & First Responder Owned',
    body: 'Built on discipline, urgency, and service. We show up and do it right.',
  },
  {
    icon: 'shield',
    title: 'Licensed & Insured',
    body: 'Qualified crews and full coverage — TODO(client): add license #s.',
  },
  {
    icon: 'doc',
    title: 'Documented & Itemized',
    body: 'Free estimates up front, before/after photos, and one clean invoice — no surprises.',
  },
  {
    icon: 'map',
    title: 'Local to Central Maryland',
    body: 'We know the area and respond fast across the counties we serve.',
  },
  {
    icon: 'check',
    title: 'One Crew for the Whole List',
    body: 'Repairs, maintenance, cleanup, and hauling — inside and out. No vendor juggling.',
  },
];
---
<BaseLayout
  title={`${site.name} | Property Management, Inspections & Handyman Services in Central Maryland`}
  description={site.description}
>
  <Hero showForm />

  <!-- Services -->
  <Section
    tone="mist"
    eyebrow="What We Do"
    title="Property Services, Inside and Out"
    lede="Management support, inspections, handyman repairs, power washing, gutters, yard cleanup, and hauling — one trusted crew for the whole list."
  >
    <ServiceGrid />
    <div class="mt-8">
      <Button href="/services/" variant="secondary">View All Services</Button>
    </div>
  </Section>

  <!-- How it works -->
  <Section
    eyebrow="How It Works"
    title="Simple From First Call to Final Walkthrough"
    lede="No runaround, no surprise charges — a clear estimate, scheduled work, and one clean invoice."
  >
    <HowItWorks />
    <div class="mt-8">
      <Button href="/contact/" variant="secondary">Get a Free Estimate</Button>
    </div>
  </Section>

  <!-- Why us -->
  <Section tone="tint" eyebrow="Why First Response" title="A Crew You Can Hand the Keys To">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        whyUs.map((item) => (
          <div class="rounded-xl border border-line border-l-4 border-l-green bg-white p-6 shadow-sm">
            <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-green/10 text-green">
              <Icon name={item.icon} size={22} />
            </span>
            <h3 class="mt-4 font-display text-h3 font-bold text-ink">{item.title}</h3>
            <p class="mt-2 text-sm text-mute">{item.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Reviews -->
  <Section
    tone="mist"
    eyebrow="Reviews"
    title="Trusted by Maryland Homeowners & Landlords"
    lede="TODO(client): replace placeholder reviews with real testimonials."
  >
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {reviews.slice(0, 3).map((review) => <ReviewCard review={review} />)}
    </div>
    <div class="mt-8">
      <Button href="/reviews/" variant="secondary">Read More Reviews</Button>
    </div>
  </Section>

  <!-- Service areas -->
  <Section
    eyebrow="Service Areas"
    title="Serving Central Maryland"
    lede="Local crews, fast scheduling, and honest timelines across the counties we serve."
  >
    <CountyChips />
    <div class="mt-8">
      <Button href="/service-areas/" variant="secondary">See All Service Areas</Button>
    </div>
  </Section>

  <CtaBand />
</BaseLayout>
