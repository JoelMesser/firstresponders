---
import Button from '../../components/Button.astro';
import CountyChips from '../../components/CountyChips.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import LeadForm from '../../components/LeadForm.astro';
import Section from '../../components/Section.astro';
import Breadcrumbs from '../../components/schema/Breadcrumbs.astro';
import ServiceSchema from '../../components/schema/Service.astro';
import { site } from '../../config/site';
import { services } from '../../data/services';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const heading = `${service.name} in ${site.address.areaLabel}`;
const otherServices = services.filter((s) => s.slug !== service.slug).slice(0, 4);
---
<BaseLayout
  title={heading}
  description={service.intro}
  type="website"
>
  <ServiceSchema slot="head" service={service} />

  <Breadcrumbs
    items={[
      { name: 'Home', href: '/' },
      { name: 'Services', href: '/services/' },
      { name: service.title, href: `/services/${service.slug}/` },
    ]}
  />

  <!-- Hero -->
  <section class="bg-green-deep text-white">
    <div class="container-px grid items-center gap-8 py-12 sm:py-16 lg:grid-cols-2">
      <div>
        <span class="flex h-14 w-14 items-center justify-center rounded-xl bg-gold/20 text-gold-light">
          <Icon name={service.icon} size={30} />
        </span>
        <h1 class="mt-5 text-hero font-extrabold">{heading}</h1>
        <p class="mt-4 max-w-xl text-lg text-white/85">{service.intro}</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <Button href={site.phone.href} size="lg" icon="phone">Call {site.phone.display}</Button>
          <Button href="#request" variant="secondary" size="lg" class="!border-white !text-white hover:!bg-white hover:!text-green-deep">
            Request Help
          </Button>
        </div>
      </div>
      <div class="rounded-xl border border-white/10 bg-white p-5 text-ink shadow-2xl sm:p-6" id="request">
        <h2 class="font-display text-xl font-extrabold text-green-deep">Get Help Now</h2>
        <p class="mt-1 text-sm text-mute">Active emergency? <a href={site.phone.href} class="font-bold text-red underline">Call {site.phone.display}</a>.</p>
        <div class="mt-4"><LeadForm compact /></div>
      </div>
    </div>
    <div class="h-1 w-full bg-gradient-to-r from-gold/30 via-gold to-gold/30" aria-hidden="true"></div>
  </section>

  <!-- Problem -->
  <Section eyebrow="The Problem" title={`Why ${service.title} Can't Wait`}>
    <p class="max-w-3xl text-lg text-mute">{service.problem}</p>
  </Section>

  <!-- Process -->
  <Section tone="mist" eyebrow="Our Process" title="How We Handle It">
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        service.process.map((step, i) => (
          <li class="relative rounded-xl border border-line bg-white p-6">
            <span class="absolute right-4 top-4 font-display text-4xl font-extrabold text-line">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="font-display text-h3 font-bold text-ink">{step.title}</h3>
            <p class="mt-2 text-sm text-mute">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Why us + insurance -->
  <Section eyebrow="Why First Response" title="The Right Team for the Job">
    <div class="grid gap-8 lg:grid-cols-2">
      <ul class="space-y-3">
        {
          service.why.map((point) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green text-white">
                <Icon name="check" size={15} />
              </span>
              <span class="text-ink">{point}</span>
            </li>
          ))
        }
      </ul>
      <div class="rounded-xl border border-line border-l-4 border-l-gold bg-mist p-6">
        <h3 class="font-display text-h3 font-bold text-green-deep">Insurance</h3>
        <p class="mt-2 text-mute">{service.insurance}</p>
        <Button href="/insurance/" variant="ghost" class="mt-3">How the claim process works →</Button>
      </div>
    </div>
  </Section>

  <!-- Service areas -->
  <Section tone="mist" eyebrow="Where We Work" title={`${service.title} Across Central Maryland`}>
    <CountyChips />
  </Section>

  <!-- Other services -->
  <Section eyebrow="More Services" title="We Handle the Whole Job">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        otherServices.map((s) => (
          <a href={`/services/${s.slug}/`} class="flex items-center gap-3 rounded-lg border border-line bg-white p-4 hover:border-gold">
            <Icon name={s.icon} size={22} class="text-green" />
            <span class="font-display font-bold text-ink">{s.title}</span>
          </a>
        ))
      }
    </div>
  </Section>

  <CtaBand title={`Need ${service.title} Help in Central Maryland?`} />
</BaseLayout>
