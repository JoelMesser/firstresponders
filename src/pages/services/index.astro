---
import CtaBand from '../../components/CtaBand.astro';
import Section from '../../components/Section.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import Breadcrumbs from '../../components/schema/Breadcrumbs.astro';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Property Services in Central Maryland"
  description="Property services in Central Maryland: property management support, inspections, handyman repairs, power washing, gutter cleaning, yard cleanup, debris removal, and fence & gate repair."
>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }]} />
  <Section
    eyebrow="Our Services"
    title="Maintenance, Repairs & Management Support"
    lede={`Whatever the property needs — inside or out — one trusted crew handles it across ${site.address.areaLabel}: from inspections and repairs to cleanup and hauling.`}
  >
    <ServiceGrid />
  </Section>
  <CtaBand />
</BaseLayout>
