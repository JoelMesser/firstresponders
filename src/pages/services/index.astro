---
import CtaBand from '../../components/CtaBand.astro';
import Section from '../../components/Section.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import Breadcrumbs from '../../components/schema/Breadcrumbs.astro';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Restoration Services in Central Maryland"
  description="Full-service emergency restoration in Central Maryland: water damage, fire & smoke, mold, storm, sewage/biohazard, demolition, reconstruction, and board-up. 24/7."
>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }]} />
  <Section
    eyebrow="Our Services"
    title="Emergency Restoration & Repair"
    lede={`Whatever the damage, we handle it end-to-end across ${site.address.areaLabel} — securing your property, stopping the loss, and rebuilding back to pre-loss condition.`}
  >
    <ServiceGrid />
  </Section>
  <CtaBand />
</BaseLayout>
